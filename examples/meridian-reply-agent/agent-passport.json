      "version": "2026-04-01"
    },
    "prompt_digest": "sha256:2f1a…c9",
    "memory": {
      "scope": "case",
      "retentionDays": 30
    },
    "tools": [
      {
        "id": "case.read"
      },
      {
        "id": "document.read"
      },
      {
        "id": "response.draft"
      },
      {
        "id": "review.request"
      }
    ],
    "data_sources": [
      "case-store",
      "document-store"
    ],
    "guardrails": [
      "pii-redaction",
      "injection-filter"
    ],
    "identity": {
      "principal": "svc-meridian-reply",
      "scope": "case-owner"
    },
    "dependencies": [
      "retrieval-svc",
      "model-api"
    ],
    "mcp_servers": [
      "mcp:case-store@1.2"
    ],
    "index_content_sources": [
      "internal:policy-library"
    ],
    "memory_write_policy": {
      "writers": [
        "agent"
      ],
      "retention": "30d",
      "rollback": "enabled"
    },
    "model_artifact_digest": "sha256:4c1e…7b"
  },
  "operating": {
    "autonomy_level": "assisted",
    "human_review": {
      "externalSend": "required",
      "caseUpdate": "required"
    },
    "recovery_objectives": {
      "rto": "30m",
      "rpo": "5m"
    },
    "permissions": [
      "case:read",
      "document:read",
      "draft:create",
      "review:request"
    ]
  },
  "entitlement": {
