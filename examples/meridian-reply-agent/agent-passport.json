{
  "schema_version": "0.1.0",
  "agent_id": "agt_meridian_reply",
  "agent_version": "3.0.0",
  "owner": "Ari Rios",
  "purpose": "Triage inbound casework and draft responses for human review.",
  "environment": "uk-south-prod",
  "created_at": "2026-09-03T00:00:00.000Z",
  "components": {
    "model": {
      "provider": "anthropic",
